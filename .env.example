# ---------------------------------------------------------------------------
# LocalGrowth AI — environment variables
# Copy this file to .env and fill in real values. Never commit real secrets.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (Neon / Supabase / Railway / Vercel Postgres / local).
# For local development without Postgres installed, run `npm run db:local` and use:
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/localgrowth?schema=public"

# Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
# Canonical URL for Auth.js on deployments (Vercel sets this automatically).
# Leave EMPTY for local development so the app also works through a tunnel (see README).
NEXTAUTH_URL=""
# Public URL used for building referral links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI provider: "anthropic" | "openai" | "mock" (mock = deterministic fallback, no key needed)
AI_PROVIDER="mock"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Payout settings (minor units — 50000 paise = ₹500)
PAYOUT_MINIMUM_AMOUNT="50000"

# Show demo quick sign-in buttons on the login page in production builds (demo deployments only)
NEXT_PUBLIC_SHOW_DEMO_LOGINS="false"

# Image storage driver: "local" (default, writes to public/uploads) — swappable for r2/s3/cloudinary/supabase later
STORAGE_PROVIDER="local"
