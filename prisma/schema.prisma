// Refnivo AI — Prisma schema
// Brand / product affiliate + referral platform.
// All monetary amounts are stored as integers in minor units (paise for INR).
// Percentage values (reward/commission) are stored in basis points (1000 = 10%).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  BRAND_OWNER
  CREATOR
  CUSTOMER
  ADMIN
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum BrandStatus {
  ACTIVE
  SUSPENDED
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum CampaignType {
  CREATOR_AFFILIATE
  CUSTOMER_REFERRAL
  HYBRID
}

enum CampaignStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  PAUSED
  ENDED
  ARCHIVED
}

enum RewardType {
  FIXED_AMOUNT
  PERCENTAGE
  VOUCHER
  DISCOUNT
}

enum CommissionType {
  FIXED_AMOUNT
  PERCENTAGE
}

enum PartnerType {
  CREATOR
  CUSTOMER
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  /// Partner withdrew a pending application themselves.
  WITHDRAWN
  /// Brand removed an approved partner; their referral link is disabled.
  REMOVED
}

enum ReferralLinkStatus {
  ACTIVE
  DISABLED
}

enum ClickSource {
  LINK
  QR
}

enum ReferralStatus {
  PENDING
  CLICKED
  VISITED
  PURCHASED
  VERIFIED
  REJECTED
  CANCELLED
  /// Verified order was refunded/cancelled after verification; ledger entries reversed.
  REFUNDED
}

enum ConversionSource {
  MANUAL
  REFERRAL_CODE
  QR_SCAN
  IMPORT
  /// Recorded by confirming a customer's order claim (order handshake).
  CUSTOMER_CLAIM
}

enum OrderClaimStatus {
  PENDING
  CONFIRMED
  REJECTED
}

/// How a claim was attributed to a referral link when it was submitted.
enum ClaimEvidence {
  /// The claimant's browser carried the last-click attribution cookie for this code.
  LAST_CLICK
  /// The claimant typed the referral code (no click on record from this browser).
  CODE_ENTERED
}

enum RewardStatus {
  PENDING
  APPROVED
  AVAILABLE
  REDEEMED
  REJECTED
  /// Reversed after a refund of the underlying order.
  REVERSED
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
  /// Reversed after a refund of the underlying order.
  REVERSED
}

enum PayoutStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  PROCESSING
  PAID
  REJECTED
  FAILED
}

/// What a payout request settles: creator commissions or customer rewards.
enum PayoutKind {
  COMMISSION
  REWARD
}

enum EmailStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

enum NotificationType {
  APPLICATION_RECEIVED
  APPLICATION_APPROVED
  APPLICATION_REJECTED
  PARTNER_REMOVED
  CAMPAIGN_PUBLISHED
  CAMPAIGN_PAUSED
  ORDER_RECORDED
  ORDER_CLAIMED
  CONVERSION_VERIFIED
  CONVERSION_REJECTED
  CONVERSION_REVERSED
  PAYOUT_REQUESTED
  PAYOUT_UPDATED
  ACCOUNT_APPROVED
  ACCOUNT_REJECTED
  ACCOUNT_SUSPENDED
  ACCOUNT_REACTIVATED
  VERIFICATION_UPDATED
  SYSTEM
}

enum AIInsightType {
  PERFORMANCE
  RECOMMENDATION
  WARNING
  INSUFFICIENT_DATA
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  /// Null for accounts created through Google sign-in that never set a password
  /// (they can add one via "Forgot password").
  passwordHash String?
  role         UserRole
  phone        String?
  avatarUrl    String?
  status       UserStatus @default(PENDING)

  // Manual verification workflow (temporary approval system).
  // registrationId is an opaque, human-readable handle safe to show/share.
  // registrationDetails holds NON-SENSITIVE role-specific fields captured at
  // signup (brand/creator info); it never contains the password or its hash.
  registrationId      String?   @unique
  registrationDetails Json?
  approvedAt          DateTime?
  approvedById        String?
  rejectedAt          DateTime?
  rejectionReason     String?

  // Session security. `sessionVersion` is embedded in the JWT at login; a
  // mismatch (password change, revocation) invalidates every existing session.
  // `mustChangePassword` forces a rotation before the dashboard can be used.
  sessionVersion     Int       @default(1)
  mustChangePassword Boolean   @default(false)
  passwordChangedAt  DateTime?
  lastLoginAt        DateTime?
  /// Notification preference: also send e-mails for important events (when a provider is configured).
  emailNotifications Boolean   @default(true)
  suspendedAt        DateTime?
  suspensionReason   String?
  /// Self-service account deletion: the row is kept (anonymised) so ledger and
  /// audit history stay intact; status becomes SUSPENDED and every login path
  /// treats the account as gone. See lib/services/account-deletion.ts.
  deletedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brands              Brand[]
  creatorProfile      CreatorProfile?
  partnerApplications PartnerApplication[]
  referralLinks       ReferralLink[]
  referralsMade       Referral[]           @relation("ReferralReferrer")
  referralsReceived   Referral[]           @relation("ReferralReferred")
  conversionsVerified Conversion[]         @relation("ConversionVerifier")
  rewards             Reward[]
  commissions         Commission[]
  payoutRequests      PayoutRequest[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  passwordResetTokens PasswordResetToken[]
  emailOutbox         EmailOutbox[]
  oauthAccounts       OAuthAccount[]
  orderClaims         OrderClaim[]         @relation("OrderClaimCustomer")
  decidedOrderClaims  OrderClaim[]         @relation("OrderClaimDecider")

  @@index([role])
  @@index([status])
  @@map("users")
}

/// External identity linked to a user (Google sign-in). One row per
/// provider account; a user may hold several providers. Tokens are NOT stored:
/// the provider is only used to prove identity at sign-in.
model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  /// E-mail reported by the provider when the account was linked (informational).
  email             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

/// A brand (e.g. a headphone company) that lists products and runs campaigns.
model Brand {
  id                 String             @id @default(cuid())
  ownerId            String
  name               String
  slug               String             @unique
  tagline            String?
  description        String?
  logoUrl            String?
  coverImageUrl      String?
  website            String?
  industry           String?
  /// { instagram?, youtube?, twitter?, facebook?, linkedin? } — public URLs only.
  socialLinks        Json?
  supportEmail       String?
  country            String             @default("India")
  verificationStatus VerificationStatus @default(UNVERIFIED)
  status             BrandStatus        @default(ACTIVE)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  products    Product[]
  campaigns   Campaign[]
  conversions Conversion[]
  aiInsights  AIInsight[]
  orderClaims OrderClaim[]

  /// v1: one brand per owner (enforced here, not only in the action).
  @@unique([ownerId])
  @@index([industry])
  @@index([status])
  @@map("brands")
}

/// A product a brand sells online. Every campaign promotes exactly one product.
model Product {
  id          String        @id @default(cuid())
  brandId     String
  name        String
  /// Globally unique — used in public URLs (/products/[slug]).
  slug        String        @unique
  description String?
  imageUrl    String?
  category    String?
  /// Minor units.
  price       Int
  currency    String        @default("INR")
  purchaseUrl String
  sku         String?
  status      ProductStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  brand     Brand      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  campaigns Campaign[]

  @@unique([brandId, sku])
  @@index([brandId])
  @@index([category])
  @@index([status])
  @@map("products")
}

model CreatorProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  displayName        String
  username           String             @unique
  bio                String?
  profileImageUrl    String?
  category           String?
  location           String?
  // --- Social presence. All numbers are SELF-REPORTED by the creator unless a
  // --- social API is connected; the UI must label them as such.
  instagramHandle    String?
  instagramUrl       String?
  instagramFollowers Int?
  youtubeChannel     String?
  youtubeUrl         String?
  youtubeSubscribers Int?
  twitterHandle      String?
  twitterUrl         String?
  averageViews       Int?
  engagementRate     Float?
  audienceCategory   String?
  audienceLocation   String?
  previousCampaigns  String?
  /// Array of public content URLs.
  contentSamples     Json?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([location])
  @@index([category])
  @@index([verificationStatus])
  @@map("creator_profiles")
}

model Campaign {
  id                     String         @id @default(cuid())
  brandId                String
  productId              String
  name                   String
  /// Globally unique — used in public URLs (/campaigns/[slug]).
  slug                   String         @unique
  description            String?
  campaignType           CampaignType   @default(HYBRID)
  /// Customer-facing headline shown on the referral landing page.
  offerTitle             String?
  offerDescription       String?
  terms                  String?
  rewardType             RewardType     @default(FIXED_AMOUNT)
  /// Minor units (paise) for FIXED_AMOUNT/VOUCHER/DISCOUNT; basis points for PERCENTAGE.
  customerRewardValue    Int
  creatorCommissionType  CommissionType @default(PERCENTAGE)
  /// Minor units (paise) for FIXED_AMOUNT; basis points for PERCENTAGE.
  creatorCommissionValue Int
  currency               String         @default("INR")
  /// Minor units. Null = no minimum order value.
  minimumPurchaseAmount  Int?
  newCustomerOnly        Boolean        @default(false)
  /// Minor units. Null = no cap.
  maxRewardPerCustomer   Int?
  attributionWindowDays  Int            @default(30)
  /// When true, creators must be approved by the brand before receiving a link.
  requiresApproval       Boolean        @default(true)
  startDate              DateTime
  endDate                DateTime?
  /// Minor units. Null = no budget cap.
  budget                 Int?
  status                 CampaignStatus @default(DRAFT)
  publishedAt            DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  brand               Brand                @relation(fields: [brandId], references: [id], onDelete: Cascade)
  product             Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  partnerApplications PartnerApplication[]
  referralLinks       ReferralLink[]
  referralClicks      ReferralClick[]
  referrals           Referral[]
  aiInsights          AIInsight[]
  orderClaims         OrderClaim[]

  @@index([brandId])
  @@index([productId])
  @@index([status])
  @@index([startDate, endDate])
  @@map("campaigns")
}

model PartnerApplication {
  id          String            @id @default(cuid())
  campaignId  String
  userId      String
  partnerType PartnerType
  status      ApplicationStatus @default(PENDING)
  message     String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
  @@index([userId])
  @@index([status])
  @@map("partner_applications")
}

/// One link per partner per campaign. `code` is human readable, e.g. ARJUN-BOAT-450.
model ReferralLink {
  id             String             @id @default(cuid())
  campaignId     String
  ownerId        String
  partnerType    PartnerType
  code           String             @unique
  destinationUrl String?
  status         ReferralLinkStatus @default(ACTIVE)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  campaign    Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  owner       User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  clicks      ReferralClick[]
  referrals   Referral[]
  orderClaims OrderClaim[]

  @@unique([campaignId, ownerId])
  @@index([ownerId])
  @@index([campaignId])
  @@map("referral_links")
}

model ReferralClick {
  id                 String      @id @default(cuid())
  referralLinkId     String
  campaignId         String
  anonymousVisitorId String
  source             ClickSource @default(LINK)
  ipHash             String?
  userAgent          String?
  referer            String?
  createdAt          DateTime    @default(now())

  referralLink ReferralLink @relation(fields: [referralLinkId], references: [id], onDelete: Cascade)
  campaign     Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([referralLinkId])
  @@index([campaignId, createdAt])
  @@index([anonymousVisitorId])
  @@map("referral_clicks")
}

/**
 * Order handshake: a customer who bought on the brand's store submits their
 * order number so the brand can attribute the sale to a referral link. Nothing
 * is owed until the brand confirms the claim (which records AND verifies the
 * order in one transaction). Contacts are stored as a salted hash plus a masked
 * display value only.
 */
model OrderClaim {
  id                String           @id @default(cuid())
  campaignId        String
  brandId           String
  referralLinkId    String
  /// Signed-in claimant, if any. Anonymous claims carry only the contact hash.
  customerId        String?
  contactHash       String
  /// e.g. "ar•••@gmail.com" or "+91 ••••• 4321" — enough for the brand to match the order, nothing more.
  contactMasked     String
  orderReference    String
  /// Upper-cased, whitespace-free reference used for the per-brand uniqueness check.
  orderReferenceKey String
  note              String?
  evidence          ClaimEvidence
  /// When the attributed click happened (LAST_CLICK evidence only).
  clickedAt         DateTime?
  status            OrderClaimStatus @default(PENDING)
  rejectionReason   String?
  decidedById       String?
  decidedAt         DateTime?
  /// The referral created when the claim was confirmed.
  referralId        String?          @unique
  ipHash            String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  campaign     Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  brand        Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  referralLink ReferralLink @relation(fields: [referralLinkId], references: [id], onDelete: Cascade)
  customer     User?        @relation("OrderClaimCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  decidedBy    User?        @relation("OrderClaimDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  referral     Referral?    @relation(fields: [referralId], references: [id], onDelete: SetNull)

  @@unique([brandId, orderReferenceKey])
  @@index([brandId, status, createdAt])
  @@index([campaignId, status])
  @@index([customerId])
  @@index([contactHash])
  @@map("order_claims")
}

model Referral {
  id                 String         @id @default(cuid())
  campaignId         String
  referralLinkId     String
  referrerId         String
  referredUserId     String?
  referredPhoneHash  String?
  anonymousVisitorId String?
  status             ReferralStatus @default(PENDING)
  qualifyingEvent    String?
  verifiedAt         DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  campaign     Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  referralLink ReferralLink @relation(fields: [referralLinkId], references: [id], onDelete: Cascade)
  referrer     User         @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUser User?        @relation("ReferralReferred", fields: [referredUserId], references: [id], onDelete: SetNull)
  conversion   Conversion?
  rewards      Reward[]
  commissions  Commission[]
  orderClaim   OrderClaim?

  @@index([campaignId, status])
  @@index([referrerId])
  @@index([referredUserId])
  @@index([referredPhoneHash])
  @@index([anonymousVisitorId])
  // Hot path for recordClick/markVisited and the FK to referral_links.
  @@index([referralLinkId, anonymousVisitorId])
  @@map("referrals")
}

/// An online order attributed to a referral. Recorded by the brand, then verified.
model Conversion {
  id             String           @id @default(cuid())
  referralId     String           @unique
  brandId        String
  orderReference String
  /// Order value in minor units.
  amount         Int
  quantity       Int              @default(1)
  currency       String           @default("INR")
  source         ConversionSource @default(MANUAL)
  verifiedById   String?
  verifiedAt     DateTime?
  /// Set when a verified order is refunded; ledger entries move to REVERSED.
  reversedAt     DateTime?
  reversalReason String?
  createdAt      DateTime         @default(now())

  referral   Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  brand      Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  verifiedBy User?    @relation("ConversionVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@unique([brandId, orderReference])
  @@index([brandId, createdAt])
  @@map("conversions")
}

model Reward {
  id          String       @id @default(cuid())
  referralId  String
  recipientId String
  rewardType  RewardType
  /// Minor units.
  amount      Int
  currency    String       @default("INR")
  status      RewardStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  referral   Referral    @relation(fields: [referralId], references: [id], onDelete: Cascade)
  recipient  User        @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  payoutItem PayoutItem?

  @@unique([referralId, recipientId])
  @@index([recipientId, status])
  @@map("rewards")
}

model Commission {
  id         String           @id @default(cuid())
  referralId String
  creatorId  String
  /// Minor units.
  amount     Int
  currency   String           @default("INR")
  status     CommissionStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  referral   Referral    @relation(fields: [referralId], references: [id], onDelete: Cascade)
  creator    User        @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  payoutItem PayoutItem?

  @@unique([referralId, creatorId])
  @@index([creatorId, status])
  @@map("commissions")
}

/// A manual settlement request. Money never moves through the platform in this
/// version: an admin settles off-platform and records the external reference.
model PayoutRequest {
  id              String       @id @default(cuid())
  userId          String
  kind            PayoutKind   @default(COMMISSION)
  /// Minor units. Frozen at request time from the linked items.
  amount          Int
  currency        String       @default("INR")
  status          PayoutStatus @default(REQUESTED)
  /// Free-text settlement method chosen by the user (e.g. "UPI", "Bank transfer", "Brand voucher"). Never account numbers.
  payoutMethod    String
  /// External settlement reference recorded by the admin when marking PAID.
  payoutReference String?
  adminNote       String?
  processedById   String?
  requestedAt     DateTime     @default(now())
  processedAt     DateTime?

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  items PayoutItem[]

  @@index([userId, status])
  @@index([status])
  @@map("payout_requests")
}

/// Links exactly one commission or reward to at most one payout request.
model PayoutItem {
  id              String  @id @default(cuid())
  payoutRequestId String
  commissionId    String? @unique
  rewardId        String? @unique
  /// Minor units, copied from the ledger row at request time.
  amount          Int

  payoutRequest PayoutRequest @relation(fields: [payoutRequestId], references: [id], onDelete: Cascade)
  commission    Commission?   @relation(fields: [commissionId], references: [id], onDelete: Cascade)
  reward        Reward?       @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  @@index([payoutRequestId])
  @@map("payout_items")
}

/// In-app notification. `href` is a relative dashboard path; `readAt` null = unread.
model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

/// Transactional e-mail outbox. Rows are written INSIDE the business
/// transaction (so a rollback leaves nothing to send) and delivered only after
/// commit by `dispatchPendingEmails`. `idempotencyKey` is unique, so the same
/// event can never queue two e-mails; delivery is claimed atomically
/// (PENDING → SENDING) so concurrent dispatchers cannot double-send.
model EmailOutbox {
  id             String      @id @default(cuid())
  userId         String?
  to             String
  subject        String
  text           String
  html           String?
  idempotencyKey String      @unique
  status         EmailStatus @default(PENDING)
  attempts       Int         @default(0)
  maxAttempts    Int         @default(5)
  nextAttemptAt  DateTime    @default(now())
  lastError      String?
  providerId     String?
  sentAt         DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([userId])
  @@map("email_outbox")
}

/// Single-use password reset token. Only the SHA-256 of the token is stored.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model AIInsight {
  id             String        @id @default(cuid())
  brandId        String
  campaignId     String?
  type           AIInsightType
  title          String
  description    String
  recommendation String?
  createdAt      DateTime      @default(now())

  brand    Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([brandId, createdAt])
  @@map("ai_insights")
}

model AuditLog {
  id         String    @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  // Request context (all optional). ipHash is a salted SHA-256, never a raw IP;
  // userAgent is truncated; requestId correlates with server logs.
  actorRole  UserRole?
  ipHash     String?
  userAgent  String?
  requestId  String?
  createdAt  DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}
