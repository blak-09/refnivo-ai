# ---------------------------------------------------------------------------
# Refnivo AI — environment variables
# Copy to .env for local development. NEVER commit .env (it is gitignored).
# Only variables prefixed NEXT_PUBLIC_ reach the browser — never put a secret there.
# In production the app validates this configuration at start-up
# (instrumentation.ts → validateProductionEnv) and refuses to boot when a
# required value is missing. Error messages name variables, never values.
# ---------------------------------------------------------------------------

# ===================== REQUIRED IN PRODUCTION ==============================

# PostgreSQL connection string. Production must use a hosted Postgres with a
# connection POOLER (Vercel/serverless opens many short-lived connections):
#   Supabase: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
#   Neon:     postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
# A local host is refused in production; port 6543 requires pgbouncer=true.
# Local dev (embedded Postgres via `npm run db:local`):
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/localgrowth?schema=public"

# Auth.js signing secret. REQUIRED — the app refuses to start without it and it
# also salts hashed IPs / customer contacts. Production requires >= 32 chars.
# Generate: openssl rand -base64 32 — use a DIFFERENT value for preview and production.
AUTH_SECRET="replace-with-a-long-random-secret"

# Public origin of THIS deployment. Used to build referral links (/r/CODE) and
# QR codes — must be the real https production URL, e.g. https://app.refnivo.ai
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Canonical URL for Auth.js callbacks. REQUIRED (https) in production because
# trustHost is enabled; AUTH_URL is accepted as an alias.
NEXTAUTH_URL=""

# Set automatically by hosting platforms / `next build`. Never set to
# "production" locally unless you are testing a production build.
# NODE_ENV="production"

# ===================== RATE LIMITING (production: configure) ================

# "memory" (default) counts per server instance — fine for `next dev` and a
# single node, but NOT shared across serverless instances. "upstash" uses a
# shared Redis counter over REST (no SDK). The limiter is fail-open: an outage
# allows requests and logs RATE_LIMIT_STORE_ERROR once per minute.
RATE_LIMIT_PROVIDER="memory"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ===================== OPTIONAL =============================================

# Minimum payout / redemption request in minor units (50000 paise = ₹500).
# Requests are settled manually by an admin (no payment provider).
PAYOUT_MINIMUM_AMOUNT="50000"

# Image storage driver: "local" writes to public/uploads (NOT durable on
# serverless hosts — files vanish on redeploy). Cloud drivers (R2/S3) are
# pluggable in lib/storage.
STORAGE_PROVIDER="local"

# Outbound e-mail. "console" (default) logs subject + masked recipient and sends
# nothing; "resend" sends through the Resend HTTP API (no SDK) and requires
# RESEND_API_KEY plus a verified EMAIL_FROM sender. Without a configured
# provider the app still works: password reset by e-mail is shown as
# unavailable and notifications stay in-app only.
# E-mails are queued in a transactional outbox and delivered after commit;
# schedule `npm run email:outbox` as the retry safety net (EMAIL_OUTBOX_BATCH
# rows per run, default 200).
EMAIL_PROVIDER="console"
RESEND_API_KEY=""
EMAIL_FROM=""

# ===================== DEVELOPMENT / TEST ONLY ==============================

# Demo quick sign-in buttons show only in non-production builds (they can never
# be enabled in production). Set to "false" to hide them on a shared dev server.
NEXT_PUBLIC_SHOW_DEMO_LOGINS="true"

# Database for `npm test` (created by `npm run db:local`).
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/localgrowth_test?schema=public"

# Escape hatches — never set these in production (start-up logs a warning):
#   RATE_LIMIT_ALLOW_MEMORY=1  accept the per-instance limiter in production
#   STORAGE_ALLOW_LOCAL=1      accept local uploads in production
#   SEED_ALLOW_REMOTE=1        allow `db:seed` on a throwaway remote database
#   ADMIN_ALLOW_LOCAL=1        allow `admin:create` on the local database

# ===================== ONE-SHOT OPERATOR COMMANDS (never store in .env) =====

# `npm run db:deploy` against a REMOTE database requires the hostname as confirmation:
#   DB_DEPLOY_CONFIRM_HOST="<db hostname>"   DB_DEPLOY_DRY_RUN=1 (preview only)
# `npm run admin:create` (see docs/PRODUCTION.md §7):
#   ADMIN_BOOTSTRAP_CONFIRM="<db hostname>"  ADMIN_EMAIL=""  ADMIN_NAME=""  ADMIN_PASSWORD=""
#   ADMIN_ROTATE_EXISTING=1   rotate the password of an EXISTING admin (never promotes other roles)
#   ADMIN_ALLOW_ADDITIONAL=1  allow creating a second admin

# ===================== FUTURE PAYMENTS (DISABLED — keep blank) ==============

# Payments and payouts are not part of this release. The app refuses to start
# in production if PAYMENTS_ENABLED is "true" or PAYMENT_PROVIDER is not NONE,
# and warns if any provider credential is set. Leave every value below blank.
PAYMENT_PROVIDER="NONE"
PAYMENTS_ENABLED="false"
PHONEPE_MERCHANT_ID=""
PHONEPE_SALT_KEY=""
PHONEPE_SALT_INDEX=""
PAYTM_MID=""
PAYTM_MERCHANT_KEY=""
PAYTM_WEBSITE=""
UPI_MANUAL_VPA=""
PAYMENT_WEBHOOK_SECRET=""
PAYOUT_ACCOUNT_ENCRYPTION_KEY=""

# Not implemented yet (reserved): AI_PROVIDER, OPENAI_API_KEY, ANTHROPIC_API_KEY
