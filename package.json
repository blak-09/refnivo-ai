{
  "name": "localgrowth-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:local": "tsx scripts/local-db.ts",
    "db:migrate": "tsx scripts/db-local-only.ts migrate-dev",
    "db:push:local": "tsx scripts/db-local-only.ts push",
    "db:reset:local": "tsx scripts/db-local-only.ts reset",
    "db:deploy": "tsx scripts/db-deploy.ts",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:target": "tsx scripts/db-target.ts",
    "postinstall": "prisma generate",
    "tunnel": "cloudflared tunnel --url http://localhost:3000 --no-autoupdate",
    "dev:all": "concurrently -n db,web -c blue,green \"tsx scripts/local-db.ts\" \"next dev\"",
    "admin:create": "tsx scripts/create-admin.ts",
    "admin:check": "tsx scripts/admin-check.ts",
    "email:outbox": "tsx scripts/email-outbox.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.45.0",
    "nanoid": "^6.0.1",
    "next": "16.3.5",
    "next-auth": "^5.0.0-beta.32",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.13.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "cloudflared": "^0.7.3",
    "concurrently": "^10.0.5",
    "dotenv": "^17.4.2",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
