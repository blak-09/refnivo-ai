// Refnivo AI — Prisma schema
// Brand / product affiliate + referral platform.
// All monetary amounts are stored as integers in minor units (paise for INR).
// Percentage values (reward/commission) are stored in basis points (1000 = 10%).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  BRAND_OWNER
  CREATOR
  CUSTOMER
  ADMIN
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum BrandStatus {
  ACTIVE
  SUSPENDED
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum CampaignType {
  CREATOR_AFFILIATE
  CUSTOMER_REFERRAL
  HYBRID
}

enum CampaignStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  PAUSED
  ENDED
  ARCHIVED
}

enum RewardType {
  FIXED_AMOUNT
  PERCENTAGE
  VOUCHER
  DISCOUNT
}

enum CommissionType {
  FIXED_AMOUNT
  PERCENTAGE
}

enum PartnerType {
  CREATOR
  CUSTOMER
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  /// Partner withdrew a pending application themselves.
  WITHDRAWN
  /// Brand removed an approved partner; their referral link is disabled.
  REMOVED
}

enum ReferralLinkStatus {
  ACTIVE
  DISABLED
}

/**
 * Where a referral link is meant to be shared. A creator can hold one link per
 * platform for the same campaign, which is the ONLY way Refnivo knows which
 * channel a sale came from: a click is never attributed to a platform by
 * guessing at the referer.
 */
/// Platforms a creator can link to their Refnivo profile.
/// Review state of a brand's listing for an affiliate program it already runs.
enum AffiliateProgramStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  PAUSED
  CLOSED
}

enum AffiliateCommissionType {
  PERCENTAGE
  FIXED
  /// Rate depends on the product or category.
  VARIES
}

/// How the external programme admits creators - decided by the brand, not by Refnivo.
enum AffiliateApprovalType {
  AUTOMATIC
  APPLICATION
  INVITE_ONLY
}

/// How an external programme works — shown so a customer referral scheme is
/// never presented as a creator affiliate programme.
enum AffiliateProgramType {
  AFFILIATE
  CREATOR_AFFILIATE
  REFERRAL
  INFLUENCER
  PARTNER
  AFFILIATE_NETWORK
  CREATOR_COMMERCE
}

enum AffiliateLinkStatus {
  ACTIVE
  DISABLED
}

enum SocialPlatform {
  INSTAGRAM
  YOUTUBE
  FACEBOOK
  LINKEDIN
  X
}

enum SocialAccountStatus {
  /// Tokens are valid as far as we know.
  CONNECTED
  /// The platform rejected our token: the creator must reconnect.
  NEEDS_RECONNECT
  /// The creator disconnected it. The row is kept so history keeps its context.
  DISCONNECTED
}

enum LinkSource {
  GENERAL
  INSTAGRAM
  YOUTUBE
  FACEBOOK
  LINKEDIN
  X
}

enum ClickSource {
  LINK
  QR
}

enum ReferralStatus {
  PENDING
  CLICKED
  VISITED
  PURCHASED
  VERIFIED
  REJECTED
  CANCELLED
  /// Verified order was refunded/cancelled after verification; ledger entries reversed.
  REFUNDED
}

enum ConversionSource {
  MANUAL
  REFERRAL_CODE
  QR_SCAN
  IMPORT
  /// Recorded by confirming a customer's order claim (order handshake).
  CUSTOMER_CLAIM
}

enum OrderClaimStatus {
  PENDING
  CONFIRMED
  REJECTED
}

/// How a claim was attributed to a referral link when it was submitted.
enum ClaimEvidence {
  /// The claimant's browser carried the last-click attribution cookie for this code.
  LAST_CLICK
  /// The claimant typed the referral code (no click on record from this browser).
  CODE_ENTERED
}

enum RewardStatus {
  PENDING
  APPROVED
  AVAILABLE
  REDEEMED
  REJECTED
  /// Reversed after a refund of the underlying order.
  REVERSED
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
  /// Reversed after a refund of the underlying order.
  REVERSED
}

/// Lifecycle of an inbound payment (a brand paying Refnivo for a plan).
enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
  /// Either side stopped the relationship; no new requests are accepted.
  BLOCKED
}

/// Which side opened the connection.
enum ConnectionInitiator {
  BRAND
  CREATOR
}

enum PaymentStatus {
  /// Local record created; the provider order may not exist yet.
  CREATED
  /// Handed to the provider; waiting for the payer.
  PENDING
  /// Payer finished checkout; awaiting server-side confirmation (verify call or webhook).
  PROCESSING
  /// Confirmed by the provider. The only status that grants anything.
  PAID
  FAILED
  CANCELLED
  /// Never completed within the checkout window.
  EXPIRED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentPurpose {
  /// A brand buying or renewing a subscription plan.
  BRAND_PLAN
}

enum SubscriptionStatus {
  ACTIVE
  /// Period ended without a new payment.
  EXPIRED
  /// Cancelled; runs to the end of the paid period.
  CANCELLED
}

enum PayoutStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  PROCESSING
  PAID
  REJECTED
  FAILED
}

/// What a payout request settles: creator commissions or customer rewards.
enum PayoutKind {
  COMMISSION
  REWARD
}

enum EmailStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

enum NotificationType {
  APPLICATION_RECEIVED
  APPLICATION_APPROVED
  APPLICATION_REJECTED
  PARTNER_REMOVED
  CAMPAIGN_PUBLISHED
  CAMPAIGN_PAUSED
  ORDER_RECORDED
  ORDER_CLAIMED
  CONNECTION_REQUESTED
  CONNECTION_ACCEPTED
  CONVERSION_VERIFIED
  CONVERSION_REJECTED
  CONVERSION_REVERSED
  PAYOUT_REQUESTED
  PAYOUT_UPDATED
  ACCOUNT_APPROVED
  ACCOUNT_REJECTED
  ACCOUNT_SUSPENDED
  ACCOUNT_REACTIVATED
  VERIFICATION_UPDATED
  SYSTEM
}

enum AIInsightType {
  PERFORMANCE
  RECOMMENDATION
  WARNING
  INSUFFICIENT_DATA
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  /// Null for accounts created through Google sign-in that never set a password
  /// (they can add one via "Forgot password").
  passwordHash String?
  role         UserRole
  phone        String?
  avatarUrl    String?
  status       UserStatus @default(PENDING)

  // Manual verification workflow (temporary approval system).
  // registrationId is an opaque, human-readable handle safe to show/share.
  // registrationDetails holds NON-SENSITIVE role-specific fields captured at
  // signup (brand/creator info); it never contains the password or its hash.
  registrationId      String?   @unique
  registrationDetails Json?
  approvedAt          DateTime?
  approvedById        String?
  rejectedAt          DateTime?
  rejectionReason     String?

  // Session security. `sessionVersion` is embedded in the JWT at login; a
  // mismatch (password change, revocation) invalidates every existing session.
  // `mustChangePassword` forces a rotation before the dashboard can be used.
  sessionVersion     Int       @default(1)
  mustChangePassword Boolean   @default(false)
  passwordChangedAt  DateTime?
  lastLoginAt        DateTime?
  /// Notification preference: also send e-mails for important events (when a provider is configured).
  emailNotifications Boolean   @default(true)
  suspendedAt        DateTime?
  suspensionReason   String?
  /// Self-service account deletion: the row is kept (anonymised) so ledger and
  /// audit history stay intact; status becomes SUSPENDED and every login path
  /// treats the account as gone. See lib/services/account-deletion.ts.
  deletedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brands              Brand[]
  creatorProfile      CreatorProfile?
  partnerApplications PartnerApplication[]
  referralLinks       ReferralLink[]
  referralsMade       Referral[]             @relation("ReferralReferrer")
  referralsReceived   Referral[]             @relation("ReferralReferred")
  conversionsVerified Conversion[]           @relation("ConversionVerifier")
  rewards             Reward[]
  commissions         Commission[]
  payoutRequests      PayoutRequest[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  passwordResetTokens PasswordResetToken[]
  emailOutbox         EmailOutbox[]
  oauthAccounts       OAuthAccount[]
  orderClaims         OrderClaim[]           @relation("OrderClaimCustomer")
  decidedOrderClaims  OrderClaim[]           @relation("OrderClaimDecider")
  payments            PaymentTransaction[]
  connections         Connection[]           @relation("CreatorConnections")
  socialAccounts      SocialAccount[]
  affiliateLinks      CreatorAffiliateLink[] @relation("CreatorAffiliateLinks")
  reviewedPrograms    AffiliateProgram[]     @relation("AffiliateProgramReviewer")

  @@index([role])
  @@index([status])
  @@map("users")
}

/// External identity linked to a user (Google sign-in). One row per
/// provider account; a user may hold several providers. Tokens are NOT stored:
/// the provider is only used to prove identity at sign-in.
model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  /// E-mail reported by the provider when the account was linked (informational).
  email             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

/// A brand (e.g. a headphone company) that lists products and runs campaigns.
model Brand {
  id                 String             @id @default(cuid())
  ownerId            String
  name               String
  slug               String             @unique
  tagline            String?
  description        String?
  logoUrl            String?
  coverImageUrl      String?
  website            String?
  industry           String?
  /// { instagram?, youtube?, twitter?, facebook?, linkedin? } — public URLs only.
  socialLinks        Json?
  supportEmail       String?
  country            String             @default("India")
  verificationStatus VerificationStatus @default(UNVERIFIED)
  status             BrandStatus        @default(ACTIVE)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  owner             User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  products          Product[]
  campaigns         Campaign[]
  conversions       Conversion[]
  aiInsights        AIInsight[]
  orderClaims       OrderClaim[]
  payments          PaymentTransaction[]
  subscription      BrandSubscription?
  connections       Connection[]
  affiliatePrograms AffiliateProgram[]

  /// v1: one brand per owner (enforced here, not only in the action).
  @@unique([ownerId])
  @@index([industry])
  @@index([status])
  @@map("brands")
}

/// A product a brand sells online. Every campaign promotes exactly one product.
model Product {
  id          String        @id @default(cuid())
  brandId     String
  name        String
  /// Globally unique — used in public URLs (/products/[slug]).
  slug        String        @unique
  description String?
  imageUrl    String?
  category    String?
  /// Minor units.
  price       Int
  currency    String        @default("INR")
  purchaseUrl String
  sku         String?
  status      ProductStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  brand     Brand      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  campaigns Campaign[]

  @@unique([brandId, sku])
  @@index([brandId])
  @@index([category])
  @@index([status])
  @@map("products")
}

model CreatorProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  displayName        String
  username           String             @unique
  bio                String?
  profileImageUrl    String?
  category           String?
  location           String?
  // --- Social presence. All numbers are SELF-REPORTED by the creator unless a
  // --- social API is connected; the UI must label them as such.
  instagramHandle    String?
  instagramUrl       String?
  instagramFollowers Int?
  youtubeChannel     String?
  youtubeUrl         String?
  youtubeSubscribers Int?
  twitterHandle      String?
  twitterUrl         String?
  averageViews       Int?
  engagementRate     Float?
  audienceCategory   String?
  audienceLocation   String?
  previousCampaigns  String?
  /// Array of public content URLs.
  contentSamples     Json?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([location])
  @@index([category])
  @@index([verificationStatus])
  @@map("creator_profiles")
}

model Campaign {
  id                     String         @id @default(cuid())
  brandId                String
  productId              String
  name                   String
  /// Globally unique — used in public URLs (/campaigns/[slug]).
  slug                   String         @unique
  description            String?
  campaignType           CampaignType   @default(HYBRID)
  /// Customer-facing headline shown on the referral landing page.
  offerTitle             String?
  offerDescription       String?
  terms                  String?
  rewardType             RewardType     @default(FIXED_AMOUNT)
  /// Minor units (paise) for FIXED_AMOUNT/VOUCHER/DISCOUNT; basis points for PERCENTAGE.
  customerRewardValue    Int
  creatorCommissionType  CommissionType @default(PERCENTAGE)
  /// Minor units (paise) for FIXED_AMOUNT; basis points for PERCENTAGE.
  creatorCommissionValue Int
  currency               String         @default("INR")
  /// Minor units. Null = no minimum order value.
  minimumPurchaseAmount  Int?
  newCustomerOnly        Boolean        @default(false)
  /// Minor units. Null = no cap.
  maxRewardPerCustomer   Int?
  attributionWindowDays  Int            @default(30)
  /// When true, creators must be approved by the brand before receiving a link.
  requiresApproval       Boolean        @default(true)
  startDate              DateTime
  endDate                DateTime?
  /// Minor units. Null = no budget cap.
  budget                 Int?
  status                 CampaignStatus @default(DRAFT)
  publishedAt            DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  brand               Brand                @relation(fields: [brandId], references: [id], onDelete: Cascade)
  product             Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  partnerApplications PartnerApplication[]
  referralLinks       ReferralLink[]
  referralClicks      ReferralClick[]
  referrals           Referral[]
  aiInsights          AIInsight[]
  orderClaims         OrderClaim[]

  @@index([brandId])
  @@index([productId])
  @@index([status])
  @@index([startDate, endDate])
  @@map("campaigns")
}

model PartnerApplication {
  id          String            @id @default(cuid())
  campaignId  String
  userId      String
  partnerType PartnerType
  status      ApplicationStatus @default(PENDING)
  message     String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
  @@index([userId])
  @@index([status])
  @@map("partner_applications")
}

/// One link per partner per campaign. `code` is human readable, e.g. ARJUN-BOAT-450.
model ReferralLink {
  id             String             @id @default(cuid())
  campaignId     String
  ownerId        String
  partnerType    PartnerType
  code           String             @unique
  /// Channel this link is for; GENERAL is the everyday link issued on joining.
  source         LinkSource         @default(GENERAL)
  destinationUrl String?
  status         ReferralLinkStatus @default(ACTIVE)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  campaign    Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  owner       User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  clicks      ReferralClick[]
  referrals   Referral[]
  orderClaims OrderClaim[]

  @@unique([campaignId, ownerId, source])
  @@index([ownerId])
  @@index([campaignId])
  @@map("referral_links")
}

model ReferralClick {
  id                 String      @id @default(cuid())
  referralLinkId     String
  campaignId         String
  anonymousVisitorId String
  source             ClickSource @default(LINK)
  ipHash             String?
  userAgent          String?
  referer            String?
  createdAt          DateTime    @default(now())

  referralLink ReferralLink @relation(fields: [referralLinkId], references: [id], onDelete: Cascade)
  campaign     Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([referralLinkId])
  @@index([campaignId, createdAt])
  @@index([anonymousVisitorId])
  @@map("referral_clicks")
}

/**
 * Order handshake: a customer who bought on the brand's store submits their
 * order number so the brand can attribute the sale to a referral link. Nothing
 * is owed until the brand confirms the claim (which records AND verifies the
 * order in one transaction). Contacts are stored as a salted hash plus a masked
 * display value only.
 */
model OrderClaim {
  id                String           @id @default(cuid())
  campaignId        String
  brandId           String
  referralLinkId    String
  /// Signed-in claimant, if any. Anonymous claims carry only the contact hash.
  customerId        String?
  contactHash       String
  /// e.g. "ar•••@gmail.com" or "+91 ••••• 4321" — enough for the brand to match the order, nothing more.
  contactMasked     String
  orderReference    String
  /// Upper-cased, whitespace-free reference used for the per-brand uniqueness check.
  orderReferenceKey String
  note              String?
  evidence          ClaimEvidence
  /// When the attributed click happened (LAST_CLICK evidence only).
  clickedAt         DateTime?
  status            OrderClaimStatus @default(PENDING)
  rejectionReason   String?
  decidedById       String?
  decidedAt         DateTime?
  /// The referral created when the claim was confirmed.
  referralId        String?          @unique
  ipHash            String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  campaign     Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  brand        Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  referralLink ReferralLink @relation(fields: [referralLinkId], references: [id], onDelete: Cascade)
  customer     User?        @relation("OrderClaimCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  decidedBy    User?        @relation("OrderClaimDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  referral     Referral?    @relation(fields: [referralId], references: [id], onDelete: SetNull)

  @@unique([brandId, orderReferenceKey])
  @@index([brandId, status, createdAt])
  @@index([campaignId, status])
  @@index([customerId])
  @@index([contactHash])
  @@map("order_claims")
}

model Referral {
  id                 String         @id @default(cuid())
  campaignId         String
  referralLinkId     String
  referrerId         String
  referredUserId     String?
  referredPhoneHash  String?
  anonymousVisitorId String?
  status             ReferralStatus @default(PENDING)
  qualifyingEvent    String?
  verifiedAt         DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  campaign     Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  referralLink ReferralLink @relation(fields: [referralLinkId], references: [id], onDelete: Cascade)
  referrer     User         @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUser User?        @relation("ReferralReferred", fields: [referredUserId], references: [id], onDelete: SetNull)
  conversion   Conversion?
  rewards      Reward[]
  commissions  Commission[]
  orderClaim   OrderClaim?

  @@index([campaignId, status])
  @@index([referrerId])
  @@index([referredUserId])
  @@index([referredPhoneHash])
  @@index([anonymousVisitorId])
  // Hot path for recordClick/markVisited and the FK to referral_links.
  @@index([referralLinkId, anonymousVisitorId])
  @@map("referrals")
}

/// An online order attributed to a referral. Recorded by the brand, then verified.
model Conversion {
  id             String           @id @default(cuid())
  referralId     String           @unique
  brandId        String
  orderReference String
  /// Order value in minor units.
  amount         Int
  quantity       Int              @default(1)
  currency       String           @default("INR")
  source         ConversionSource @default(MANUAL)
  verifiedById   String?
  verifiedAt     DateTime?
  /// Set when a verified order is refunded; ledger entries move to REVERSED.
  reversedAt     DateTime?
  reversalReason String?
  createdAt      DateTime         @default(now())

  referral   Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  brand      Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  verifiedBy User?    @relation("ConversionVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@unique([brandId, orderReference])
  @@index([brandId, createdAt])
  @@map("conversions")
}

model Reward {
  id          String       @id @default(cuid())
  referralId  String
  recipientId String
  rewardType  RewardType
  /// Minor units.
  amount      Int
  currency    String       @default("INR")
  status      RewardStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  referral   Referral    @relation(fields: [referralId], references: [id], onDelete: Cascade)
  recipient  User        @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  payoutItem PayoutItem?

  @@unique([referralId, recipientId])
  @@index([recipientId, status])
  @@map("rewards")
}

model Commission {
  id         String           @id @default(cuid())
  referralId String
  creatorId  String
  /// Minor units.
  amount     Int
  currency   String           @default("INR")
  status     CommissionStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  referral   Referral    @relation(fields: [referralId], references: [id], onDelete: Cascade)
  creator    User        @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  payoutItem PayoutItem?

  @@unique([referralId, creatorId])
  @@index([creatorId, status])
  @@map("commissions")
}

/// A manual settlement request. Money never moves through the platform in this
/// version: an admin settles off-platform and records the external reference.
/**
 * One inbound payment attempt. The provider is the source of truth: a row only
 * reaches PAID after server-side verification (checkout signature + the payment
 * fetched back from the provider) or a signed webhook. Nothing sensitive is
 * stored - no card numbers, no CVV, no provider secrets; `method` is a coarse
 * label such as "upi" or "card" as reported by the provider.
 */
/**
 * A direct brand <-> creator relationship, independent of any campaign.
 * One row per pair (unique on brandId+creatorId), so a request from either
 * direction lands on the same relationship and cannot be duplicated by both
 * sides asking at once. `initiator` records who asked, which is what decides
 * whose inbox a PENDING row appears in.
 */
/**
 * A creator's linked social account.
 * Connected through the platform's own OAuth flow - Refnivo never sees a social
 * password. Tokens are encrypted at rest (lib/security/secret-box) and are only
 * ever used for the scopes the creator granted.
 * `followers` is nullable on purpose: several platforms do not expose a follower
 * count to the scopes we request, and an unknown count must render as "not
 * available through the platform API" rather than as a number we invented. It is
 * always accompanied by `followersSyncedAt` so the profile can say how fresh it is.
 * Disconnecting sets DISCONNECTED and clears the tokens; the row (and every
 * campaign, referral and commission the creator earned) is kept.
 */
/**
 * An affiliate programme a brand ALREADY runs somewhere else, listed on Refnivo
 * so creators can find it.
 * Refnivo is a discovery and tracking layer here, nothing more: approval,
 * commission calculation and payment all stay with the external programme. That
 * is why this model has no commission amount, no reward rules and no payout
 * fields - only a *description* of terms the brand states, plus the official
 * URLs a creator needs. Nothing in it creates a liability for Refnivo.
 * `verifiedAt` is set by an admin who actually opened the URLs and checked the
 * programme exists; it is never implied by the listing being published.
 */
model AffiliateProgram {
  id                    String                   @id @default(cuid())
  /// The brand's Refnivo account, when it has one. Null for a listing Refnivo
  /// curated from public information (the brand has not joined Refnivo).
  brandId               String?
  /// Display name for a curated listing. A CHECK constraint requires brandId or brandName.
  brandName             String?
  name                  String
  slug                  String                   @unique
  programType           AffiliateProgramType     @default(AFFILIATE)
  description           String?
  category              String?
  subcategory           String?
  /// Creator audiences the programme suits, e.g. "Tech creators". Discovery aid only.
  bestFor               String[]                 @default([])
  /// Pinned to the top of the marketplace by an admin. Not a quality ranking.
  featured              Boolean                  @default(false)
  /// The brand's own site, the programme page, and where a creator signs up.
  websiteUrl            String?
  programUrl            String?
  signupUrl             String
  logoUrl               String?
  /// What the programme says it pays. Displayed as the programme's claim, never as a
  /// Refnivo promise. Null = not stated publicly (never guessed).
  commissionType        AffiliateCommissionType?
  commissionDescription String?
  /// Attribution window the external network advertises, in days.
  cookieDurationDays    Int?
  /// Affiliate network running it (Impact, Amazon Associates, in-house...).
  networkName           String?
  /// Null = the programme does not say how creators are admitted.
  approvalType          AffiliateApprovalType?
  status                AffiliateProgramStatus   @default(DRAFT)
  /// Optional requirements the brand states for creators.
  minFollowers          Int?
  supportedPlatforms    SocialPlatform[]         @default([])
  geography             String?
  requirements          String?
  /**
   * Query parameter the network accepts for a sub id, e.g. "subId" or "aff_sub".
   * Left empty unless the brand confirms the network supports one - a parameter
   * the network does not understand is at best ignored and at worst breaks the link.
   */
  subIdParam            String?
  submittedAt           DateTime?
  reviewedAt            DateTime?
  reviewedById          String?
  reviewNote            String?
  /// Set only when an admin has actually checked the brand and the URLs. Shown
  /// as "Program verified on …" together with sourceUrl.
  verifiedAt            DateTime?
  /// The official page the listed facts were checked against.
  sourceUrl             String?
  /// Last automated check of the official programme URL ("ok 200", "broken 404", "unreachable").
  linkCheckedAt         DateTime?
  linkStatus            String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  brand      Brand?                 @relation(fields: [brandId], references: [id], onDelete: Cascade)
  reviewedBy User?                  @relation("AffiliateProgramReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  links      CreatorAffiliateLink[]
  clicks     AffiliateClick[]

  @@index([status, updatedAt])
  @@index([brandId, status])
  @@index([category, status])
  @@index([featured, status])
  @@map("affiliate_programs")
}

/**
 * A creator's own affiliate URL for an external programme, plus the Refnivo
 * tracking codes that point at it.
 * The creator obtains the URL from the external network after being approved
 * THERE; Refnivo stores it so it can count clicks before forwarding. One row per
 * creator per programme; the per-platform codes hang off it.
 */
model CreatorAffiliateLink {
  id                  String              @id @default(cuid())
  creatorId           String
  affiliateProgramId  String
  /// The destination the external network gave the creator.
  targetUrl           String
  status              AffiliateLinkStatus @default(ACTIVE)
  /// The creator's id inside the external network, when they know it (for reconciliation later).
  externalAffiliateId String?
  note                String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  creator User                    @relation("CreatorAffiliateLinks", fields: [creatorId], references: [id], onDelete: Cascade)
  program AffiliateProgram        @relation(fields: [affiliateProgramId], references: [id], onDelete: Cascade)
  codes   AffiliateTrackingCode[]
  clicks  AffiliateClick[]

  @@unique([creatorId, affiliateProgramId])
  @@index([affiliateProgramId])
  @@map("creator_affiliate_links")
}

/**
 * One shareable Refnivo code per platform, all forwarding to the same external
 * affiliate URL. Separate codes are the only way to know which platform a click
 * came from - the referer is not trustworthy.
 */
model AffiliateTrackingCode {
  id                     String              @id @default(cuid())
  creatorAffiliateLinkId String
  /// Shares the code namespace with campaign referral links, so /r/CODE resolves either.
  code                   String              @unique
  source                 LinkSource          @default(GENERAL)
  status                 AffiliateLinkStatus @default(ACTIVE)
  createdAt              DateTime            @default(now())

  link   CreatorAffiliateLink @relation(fields: [creatorAffiliateLinkId], references: [id], onDelete: Cascade)
  clicks AffiliateClick[]

  @@unique([creatorAffiliateLinkId, source])
  @@map("affiliate_tracking_codes")
}

/**
 * A click Refnivo actually observed before forwarding to the external network.
 * This is the ONLY thing Refnivo can honestly report for an external programme:
 * whether the visitor went on to buy is known to the network, not to us. There
 * is deliberately no conversion or revenue column here.
 */
model AffiliateClick {
  id                     String     @id @default(cuid())
  trackingCodeId         String
  creatorAffiliateLinkId String
  affiliateProgramId     String
  creatorId              String
  source                 LinkSource
  /// Anonymous visitor id (cookie) and a salted IP hash - never a raw address.
  anonymousVisitorId     String?
  ipHash                 String?
  userAgent              String?
  referer                String?
  /// Sub id we appended to the outbound URL, when the network supports one.
  subId                  String?
  createdAt              DateTime   @default(now())

  trackingCode AffiliateTrackingCode @relation(fields: [trackingCodeId], references: [id], onDelete: Cascade)
  link         CreatorAffiliateLink  @relation(fields: [creatorAffiliateLinkId], references: [id], onDelete: Cascade)
  program      AffiliateProgram      @relation(fields: [affiliateProgramId], references: [id], onDelete: Cascade)

  @@index([creatorAffiliateLinkId, createdAt])
  @@index([affiliateProgramId, createdAt])
  @@index([creatorId, createdAt])
  @@map("affiliate_clicks")
}

model SocialAccount {
  id                String              @id @default(cuid())
  userId            String
  platform          SocialPlatform
  /// The platform's own id for the account - stable across handle changes.
  providerAccountId String
  handle            String?
  profileUrl        String?
  avatarUrl         String?
  /// Only when the platform's API actually returns it under the granted scopes.
  followers         Int?
  followersSyncedAt DateTime?
  /// Encrypted (AES-256-GCM). Never logged, never sent to the browser.
  accessToken       String?
  refreshToken      String?
  tokenExpiresAt    DateTime?
  /// Exactly the scopes the creator granted, for the disclosure on the profile page.
  scopes            String[]            @default([])
  status            SocialAccountStatus @default(CONNECTED)
  /// Set when the platform last refused our token, so the UI can explain the reconnect.
  lastErrorAt       DateTime?
  connectedAt       DateTime            @default(now())
  lastSyncedAt      DateTime?
  updatedAt         DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One account per platform per creator.
  @@unique([userId, platform])
  /// The same social account cannot be claimed by two Refnivo users.
  @@unique([platform, providerAccountId])
  @@index([userId, status])
  @@map("social_accounts")
}

model Connection {
  id           String              @id @default(cuid())
  brandId      String
  /// The creator's user id (creators are users with a CreatorProfile).
  creatorId    String
  initiator    ConnectionInitiator
  status       ConnectionStatus    @default(PENDING)
  /// Why the sender wants to connect; shown to the other side.
  message      String?
  /// Optional note from the responder when declining.
  responseNote String?
  respondedAt  DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  brand   Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  creator User  @relation("CreatorConnections", fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([brandId, creatorId])
  @@index([brandId, status, createdAt])
  @@index([creatorId, status, createdAt])
  @@map("connections")
}

model PaymentTransaction {
  id                String         @id @default(cuid())
  /// Human-readable reference shown to the payer and used in support ("RFN-XXXXXXXX").
  reference         String         @unique
  userId            String
  /// Brand the payment is for (plans are per brand workspace).
  brandId           String?
  purpose           PaymentPurpose @default(BRAND_PLAN)
  /// Plan key at purchase time (see lib/config/plans.ts). Never taken from the client.
  planKey           String?
  /// Minor units, resolved server-side from the plan and frozen here.
  amount            Int
  currency          String         @default("INR")
  status            PaymentStatus  @default(CREATED)
  provider          String
  /// Provider order id (before checkout) and payment id (after the payer pays).
  providerOrderId   String?        @unique
  providerPaymentId String?        @unique
  /// Coarse method label from the provider (upi / card / netbanking). Never credentials.
  method            String?
  /// Machine-readable code plus a short safe description; provider detail stays in the logs.
  failureCode       String?
  failureReason     String?
  refundedAmount    Int            @default(0)
  /// Non-sensitive context (plan name, period, provider refund ids).
  metadata          Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  paidAt            DateTime?
  /// After this, an unpaid attempt is treated as EXPIRED.
  expiresAt         DateTime?

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand         Brand?              @relation(fields: [brandId], references: [id], onDelete: SetNull)
  events        PaymentEvent[]
  subscriptions BrandSubscription[]

  @@index([userId, createdAt])
  @@index([brandId, createdAt])
  @@index([status, createdAt])
  @@map("payment_transactions")
}

/**
 * Every provider webhook we accept, recorded before it is applied.
 * `providerEventId` is unique, so replaying a webhook can never grant twice.
 */
model PaymentEvent {
  id              String   @id @default(cuid())
  provider        String
  /// Provider event id, or a digest of the payload when the provider sends none.
  providerEventId String   @unique
  type            String
  transactionId   String?
  /// True once the event changed something; a duplicate is stored but not applied.
  applied         Boolean  @default(false)
  payload         Json?
  createdAt       DateTime @default(now())

  transaction PaymentTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([transactionId, createdAt])
  @@map("payment_events")
}

/// A brand's plan. Granted only by a PAID transaction.
model BrandSubscription {
  id               String             @id @default(cuid())
  brandId          String             @unique
  planKey          String
  status           SubscriptionStatus @default(ACTIVE)
  startedAt        DateTime           @default(now())
  /// End of the paid period; the plan lapses after this.
  currentPeriodEnd DateTime
  cancelledAt      DateTime?
  /// Payment that last granted or renewed the plan.
  transactionId    String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  brand       Brand               @relation(fields: [brandId], references: [id], onDelete: Cascade)
  transaction PaymentTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([status, currentPeriodEnd])
  @@map("brand_subscriptions")
}

model PayoutRequest {
  id              String       @id @default(cuid())
  userId          String
  kind            PayoutKind   @default(COMMISSION)
  /// Minor units. Frozen at request time from the linked items.
  amount          Int
  currency        String       @default("INR")
  status          PayoutStatus @default(REQUESTED)
  /// Free-text settlement method chosen by the user (e.g. "UPI", "Bank transfer", "Brand voucher"). Never account numbers.
  payoutMethod    String
  /// External settlement reference recorded by the admin when marking PAID.
  payoutReference String?
  adminNote       String?
  processedById   String?
  requestedAt     DateTime     @default(now())
  processedAt     DateTime?

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  items PayoutItem[]

  @@index([userId, status])
  @@index([status])
  @@map("payout_requests")
}

/// Links exactly one commission or reward to at most one payout request.
model PayoutItem {
  id              String  @id @default(cuid())
  payoutRequestId String
  commissionId    String? @unique
  rewardId        String? @unique
  /// Minor units, copied from the ledger row at request time.
  amount          Int

  payoutRequest PayoutRequest @relation(fields: [payoutRequestId], references: [id], onDelete: Cascade)
  commission    Commission?   @relation(fields: [commissionId], references: [id], onDelete: Cascade)
  reward        Reward?       @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  @@index([payoutRequestId])
  @@map("payout_items")
}

/// In-app notification. `href` is a relative dashboard path; `readAt` null = unread.
model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

/// Transactional e-mail outbox. Rows are written INSIDE the business
/// transaction (so a rollback leaves nothing to send) and delivered only after
/// commit by `dispatchPendingEmails`. `idempotencyKey` is unique, so the same
/// event can never queue two e-mails; delivery is claimed atomically
/// (PENDING → SENDING) so concurrent dispatchers cannot double-send.
model EmailOutbox {
  id             String      @id @default(cuid())
  userId         String?
  to             String
  subject        String
  text           String
  html           String?
  idempotencyKey String      @unique
  status         EmailStatus @default(PENDING)
  attempts       Int         @default(0)
  maxAttempts    Int         @default(5)
  nextAttemptAt  DateTime    @default(now())
  lastError      String?
  providerId     String?
  sentAt         DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([userId])
  @@map("email_outbox")
}

/// Single-use password reset token. Only the SHA-256 of the token is stored.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model AIInsight {
  id             String        @id @default(cuid())
  brandId        String
  campaignId     String?
  type           AIInsightType
  title          String
  description    String
  recommendation String?
  createdAt      DateTime      @default(now())

  brand    Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([brandId, createdAt])
  @@map("ai_insights")
}

model AuditLog {
  id         String    @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  // Request context (all optional). ipHash is a salted SHA-256, never a raw IP;
  // userAgent is truncated; requestId correlates with server logs.
  actorRole  UserRole?
  ipHash     String?
  userAgent  String?
  requestId  String?
  createdAt  DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}
